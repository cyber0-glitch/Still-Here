generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)

  // Profile
  displayName      String   @map("display_name") @db.VarChar(100)
  age              Int?
  locationCity     String?  @map("location_city") @db.VarChar(100)
  locationCountry  String?  @map("location_country") @db.VarChar(100)
  locationLat      Decimal? @map("location_lat") @db.Decimal(10, 8)
  locationLng      Decimal? @map("location_lng") @db.Decimal(11, 8)
  radiusKm         Int      @default(50) @map("radius_km")
  avatarUrl        String?  @map("avatar_url") @db.VarChar(500)

  // Condition
  conditionSummary String? @map("condition_summary") @db.Text

  // Energy & Accessibility
  energyLevel   String  @default("varies") @map("energy_level") @db.VarChar(20)
  mobilityNotes String? @map("mobility_notes") @db.Text

  // Profile Prompts
  promptNoPatience       String? @map("prompt_no_patience_for") @db.Text
  promptWantCompany      String? @map("prompt_want_company_for") @db.Text
  promptBodyCanHandle    String? @map("prompt_body_can_handle") @db.Text
  promptDontTalkLike     String? @map("prompt_dont_talk_to_me_like") @db.Text
  promptBeforeIGo        String? @map("prompt_before_i_go") @db.Text
  promptFreeform         String? @map("prompt_freeform") @db.Text

  // Verification
  verificationStatus String    @default("basic") @map("verification_status") @db.VarChar(20)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz()
  communityCodeUsed  String?   @map("community_code_used") @db.VarChar(100)

  // Preferences
  contactPreference  String  @default("both") @map("contact_preference") @db.VarChar(20)
  showOnlineStatus   Boolean @default(true) @map("show_online_status")
  allowCaregiverView Boolean @default(false) @map("allow_caregiver_view")

  // Memorial Preferences
  memorialPreference String?  @default("undecided") @map("memorial_preference") @db.VarChar(20)
  memorialMessage    String?  @map("memorial_message") @db.Text

  // Status
  isActive           Boolean   @default(true) @map("is_active")
  isMemorial         Boolean   @default(false) @map("is_memorial")
  memorialActivatedAt DateTime? @map("memorial_activated_at") @db.Timestamptz()
  lastActiveAt       DateTime? @map("last_active_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()

  // Admin
  isAdmin Boolean @default(false) @map("is_admin")

  // Relations
  momentRequests     MomentRequest[]
  momentResponses    MomentResponse[]
  conversationParts  ConversationParticipant[]
  messagesSent       Message[]
  connectionsA       Connection[]     @relation("ConnectionA")
  connectionsB       Connection[]     @relation("ConnectionB")
  memorial           Memorial?
  memorialActivator  Memorial[]       @relation("MemorialActivator")
  memorialMemories   MemorialMemory[]
  reportsSubmitted   Report[]         @relation("Reporter")
  reportsReceived    Report[]         @relation("Reported")
  groupEventsOrg     GroupEvent[]
  groupEventAttendee GroupEventAttendee[]
  notifications      Notification[]
  designatedPersons  DesignatedPerson[]

  @@map("users")
}

model DesignatedPerson {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  name     String @db.VarChar(200)
  contact  String @db.VarChar(255)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("designated_persons")
}

model MomentRequest {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String @db.VarChar(200)
  description String? @db.Text
  category    String @db.VarChar(50)

  locationType   String  @default("flexible") @map("location_type") @db.VarChar(20)
  locationName   String? @map("location_name") @db.VarChar(200)
  locationLat    Decimal? @map("location_lat") @db.Decimal(10, 8)
  locationLng    Decimal? @map("location_lng") @db.Decimal(11, 8)
  preferredDate  DateTime? @map("preferred_date") @db.Date
  preferredTime  String?  @map("preferred_time_of_day") @db.VarChar(20)

  energyLevelNeeded String? @map("energy_level_needed") @db.VarChar(20)
  maxParticipants   Int     @default(1) @map("max_participants")

  status    String    @default("open") @db.VarChar(20)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  responses    MomentResponse[]
  conversation Conversation?    @relation()

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("moment_requests")
}

model MomentResponse {
  id          String @id @default(uuid()) @db.Uuid
  momentId    String @map("moment_id") @db.Uuid
  responderId String @map("responder_id") @db.Uuid

  message String? @db.Text
  status  String  @default("pending") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  moment    MomentRequest @relation(fields: [momentId], references: [id], onDelete: Cascade)
  responder User          @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@unique([momentId, responderId])
  @@map("moment_responses")
}

model Conversation {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz()

  originMomentId String?        @unique @map("origin_moment_id") @db.Uuid
  originMoment   MomentRequest? @relation(fields: [originMomentId], references: [id], onDelete: SetNull)

  memorialLocked Boolean @default(false) @map("memorial_locked")

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz()
  muted      Boolean   @default(false)
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  senderId       String? @map("sender_id") @db.Uuid

  content     String @db.Text
  messageType String @default("text") @map("message_type") @db.VarChar(20)

  systemEventType String? @map("system_event_type") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  editedAt  DateTime? @map("edited_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model Connection {
  id       String @id @default(uuid()) @db.Uuid
  userAId  String @map("user_a_id") @db.Uuid
  userBId  String @map("user_b_id") @db.Uuid

  status       String @default("connected") @db.VarChar(20)
  connectedVia String? @map("connected_via") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userA User @relation("ConnectionA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ConnectionB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@map("connections")
}

model Memorial {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  activatedBy       String? @map("activated_by") @db.VarChar(20)
  activatedByUserId String? @map("activated_by_user_id") @db.Uuid

  displayMessage String?  @map("display_message") @db.Text
  allowMemories  Boolean  @default(true) @map("allow_memories")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activator User?            @relation("MemorialActivator", fields: [activatedByUserId], references: [id])
  memories  MemorialMemory[]

  @@map("memorials")
}

model MemorialMemory {
  id         String  @id @default(uuid()) @db.Uuid
  memorialId String  @map("memorial_id") @db.Uuid
  authorId   String? @map("author_id") @db.Uuid

  content  String  @db.Text
  imageUrl String? @map("image_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  memorial Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("memorial_memories")
}

model Report {
  id             String @id @default(uuid()) @db.Uuid
  reporterId     String? @map("reporter_id") @db.Uuid
  reportedUserId String @map("reported_user_id") @db.Uuid

  reason      String  @db.VarChar(50)
  details     String? @db.Text

  status      String  @default("pending") @db.VarChar(20)
  reviewedBy  String? @map("reviewed_by") @db.VarChar(100)
  reviewNotes String? @map("review_notes") @db.Text

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz()

  reporter     User?  @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User   @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reportedUserId])
  @@index([createdAt])
  @@map("reports")
}

model BlockedPhrase {
  id       String  @id @default(uuid()) @db.Uuid
  phrase   String  @unique @db.VarChar(200)
  category String? @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  @@map("blocked_phrases")
}

model CommunityCode {
  id               String @id @default(uuid()) @db.Uuid
  organizationName String @map("organization_name") @db.VarChar(200)
  organizationType String? @map("organization_type") @db.VarChar(50)
  code             String @unique @db.VarChar(50)

  isActive    Boolean   @default(true) @map("is_active")
  maxUses     Int?      @map("max_uses")
  currentUses Int       @default(0) @map("current_uses")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime? @map("expires_at") @db.Timestamptz()

  @@map("community_codes")
}

model GroupEvent {
  id          String @id @default(uuid()) @db.Uuid
  organizerId String? @map("organizer_id") @db.Uuid

  title       String @db.VarChar(200)
  description String? @db.Text
  category    String @db.VarChar(50)

  locationName    String? @map("location_name") @db.VarChar(200)
  locationAddress String? @map("location_address") @db.Text
  locationLat     Decimal? @map("location_lat") @db.Decimal(10, 8)
  locationLng     Decimal? @map("location_lng") @db.Decimal(11, 8)
  isVirtual       Boolean @default(false) @map("is_virtual")
  virtualLink     String? @map("virtual_link") @db.VarChar(500)

  eventDate       DateTime @map("event_date") @db.Timestamptz()
  durationMinutes Int?     @map("duration_minutes")

  maxAttendees       Int?    @map("max_attendees")
  energyLevel        String? @map("energy_level") @db.VarChar(20)
  accessibilityNotes String? @map("accessibility_notes") @db.Text

  status String @default("upcoming") @db.VarChar(20)

  partnerId String? @map("partner_id") @db.Uuid
  partner   ExperiencePartner? @relation(fields: [partnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organizer User?                @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  attendees GroupEventAttendee[]

  @@map("group_events")
}

model GroupEventAttendee {
  eventId  String @map("event_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  status   String @default("going") @db.VarChar(20)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  event GroupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("group_event_attendees")
}

model ExperiencePartner {
  id           String  @id @default(uuid()) @db.Uuid
  businessName String  @map("business_name") @db.VarChar(200)
  description  String? @db.Text
  category     String? @db.VarChar(50)
  websiteUrl   String? @map("website_url") @db.VarChar(500)
  contactEmail String? @map("contact_email") @db.VarChar(255)

  locationCity    String? @map("location_city") @db.VarChar(100)
  locationCountry String? @map("location_country") @db.VarChar(100)

  isVetted   Boolean   @default(false) @map("is_vetted")
  vettedAt   DateTime? @map("vetted_at") @db.Timestamptz()
  vettedNotes String?  @map("vetted_notes") @db.Text

  offersDescription  String? @map("offers_description") @db.Text
  accessibilityInfo  String? @map("accessibility_info") @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  events GroupEvent[]

  @@map("experience_partners")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String @db.VarChar(50)
  title   String @db.VarChar(200)
  body    String @db.Text
  read    Boolean @default(false)
  data    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@index([read])
  @@map("notifications")
}
